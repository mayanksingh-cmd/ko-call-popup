# ── Zoom SDK ──────────────────────────────────────────────────────────────────
ZOOM_MEETING_SDK_KEY=your_client_id_here
ZOOM_MEETING_SDK_SECRET=your_client_secret_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
APP_BASE_URL=http://localhost:3000   # set to your production domain when deployed

# ── Demo meeting (local testing only) ─────────────────────────────────────────
DEMO_MEETING_NUMBER=your_meeting_number
DEMO_MEETING_PASSCODE=your_passcode
DEMO_USER_EMAIL=your@email.com       # recovery email will be sent here in demo
DEMO_USER_PHONE=+1234567890          # optional — SMS sent here if Twilio is configured

# ── Email (nodemailer / SMTP) ─────────────────────────────────────────────────
# Works with any SMTP provider: Gmail, SendGrid, Resend, Postmark, etc.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@yourapp.com

# ── SMS — Twilio (optional) ───────────────────────────────────────────────────
# Leave blank to skip SMS entirely
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
